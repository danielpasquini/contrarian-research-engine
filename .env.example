# Application
APP_ENV=development
LOG_LEVEL=INFO
TIMEZONE=America/Sao_Paulo

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/contrarian

# LLM provider (Runtime - called ONLY on pre-filtered candidates)
LLM_PROVIDER=google
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.0
GEMINI_MAX_DAILY_CALLS=150

# SEC EDGAR (Required by SEC fair-access policy: Name + Email)
SEC_USER_AGENT="ContrarianResearchEngine seu_email@dominio.com"

# Alpaca market data
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_DATA_FEED=iex

# Alpaca execution (Paper Trading Lock)
ALPACA_PAPER=true
ALPACA_PAPER_API_URL=https://paper-api.alpaca.markets

# Execution safety & Volatility Risk Engine
EXECUTION_MODE=research
ENABLE_ORDER_SUBMISSION=false
ALLOW_AVERAGING_DOWN=false
REQUIRE_BRACKET_ORDER=true
EARNINGS_BLACKOUT_DAYS=3
ATR_PERIOD=14
ATR_STOP_MULTIPLIER=2.0
MIN_REWARD_RISK_RATIO=2.0
MAX_RISK_PER_TRADE_PCT=0.005
MAX_POSITION_PCT=0.08
MAX_PORTFOLIO_EXPOSURE=0.40
MAX_DAILY_LOSS_PCT=0.015
MAX_OPEN_POSITIONS=6
MAX_DAILY_ORDERS=2

# Research & Pre-Filter Scanner
UNIVERSE_SIZE=500
MAX_DAILY_LLM_CANDIDATES=15
MIN_AVERAGE_DOLLAR_VOLUME=20000000
MIN_SHARE_PRICE=10.0
SIGNAL_HORIZONS=1,5,10,20

# Scheduling
INGESTION_ENABLED=false
PAPER_TRADING_ENABLED=false